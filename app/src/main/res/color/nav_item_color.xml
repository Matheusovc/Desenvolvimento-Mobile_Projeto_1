<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone/rótulo da barra inferior: branco (neutro) quando ativo, cinza quando inativo.
     A distinção do estado ativo vem da cor + do ícone preenchido + da pílula translúcida. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/color_on_surface" android:state_checked="true" />
    <item android:color="@color/color_on_surface_variant" />
</selector>
