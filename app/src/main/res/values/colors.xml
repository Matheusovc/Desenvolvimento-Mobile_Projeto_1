<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Identidade visual FieldService: dark mode é o modo padrão e único do app,
         para manter aparência corporativa consistente em qualquer dispositivo. -->

    <!-- Superfícies -->
    <color name="color_background">#0F1115</color>
    <color name="color_surface">#181B21</color>
    <color name="color_surface_variant">#20242C</color>
    <color name="color_outline">#2A2F3A</color>

    <!-- Texto -->
    <color name="color_on_background">#FFFFFF</color>
    <color name="color_on_surface">#FFFFFF</color>
    <color name="color_on_surface_variant">#A7ADB8</color>

    <!-- Marca / destaque -->
    <color name="color_primary">#4C8DFF</color>
    <color name="color_on_primary">#FFFFFF</color>
    <color name="color_error">#EF5350</color>
    <color name="color_on_error">#FFFFFF</color>

    <!-- Prioridade do chamado (sempre acompanhada de texto, nunca só cor) -->
    <color name="priority_low">#66BB6A</color>
    <color name="priority_medium">#FFB74D</color>
    <color name="priority_high">#FF8A65</color>
    <color name="priority_critical">#EF5350</color>

    <!-- Status do chamado -->
    <color name="status_neutral">#9AA5B1</color>
    <color name="status_in_progress">#64B5F6</color>
    <color name="status_completed">#66BB6A</color>
    <color name="status_cancelled">#B0B0B0</color>
</resources>
