<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Identidade visual FieldService: dark mode é o modo padrão e único do app,
         para manter aparência corporativa consistente em qualquer dispositivo.
         Escala de superfícies: quanto mais "alto" o elemento, mais clara a superfície. -->

    <!-- Superfícies (do fundo para o topo) -->
    <color name="color_background">#0B0D10</color>
    <color name="color_surface">#12151A</color>
    <color name="color_card">#181C22</color>
    <color name="color_card_highlight">#1E232B</color>
    <!-- Mantido por compatibilidade: usado como fundo de destaque/selo -->
    <color name="color_surface_variant">#1E232B</color>
    <color name="color_outline">#292F38</color>

    <!-- Texto -->
    <color name="color_on_background">#FFFFFF</color>
    <color name="color_on_surface">#FFFFFF</color>
    <color name="color_on_surface_variant">#A8AFBA</color>
    <color name="color_on_surface_muted">#6C7480</color>

    <!-- Marca / destaque -->
    <color name="color_primary">#4C8DFF</color>
    <color name="color_primary_dim">#2E5BB0</color>
    <color name="color_on_primary">#FFFFFF</color>
    <color name="color_error">#FF5A5F</color>
    <color name="color_on_error">#FFFFFF</color>

    <!-- Cores semânticas (feedback e status) -->
    <color name="color_success">#3DD68C</color>
    <color name="color_warning">#FFB74D</color>
    <color name="color_danger">#FF5A5F</color>
    <color name="color_info">#4C8DFF</color>

    <!-- Prioridade do chamado (sempre acompanhada de texto/ícone, nunca só cor).
         Gradiente claramente distinto: verde -> amarelo -> laranja -> vermelho. -->
    <color name="priority_low">#66BB6A</color>
    <color name="priority_medium">#FFCA3A</color>
    <color name="priority_high">#FF922B</color>
    <color name="priority_critical">#FF4D4F</color>

    <!-- Status do chamado -->
    <color name="status_neutral">#9AA5B1</color>
    <color name="status_in_progress">#64B5F6</color>
    <color name="status_completed">#3DD68C</color>
    <color name="status_cancelled">#8A929E</color>

    <!-- Liquid glass: botões translúcidos estilo vidro (iOS-like) sobre o fundo escuro -->
    <color name="glass_fill">#1FFFFFFF</color>
    <color name="glass_stroke">#4DFFFFFF</color>
    <color name="glass_ripple">#40FFFFFF</color>
    <color name="glass_primary_fill">#3D4C8DFF</color>
    <color name="glass_primary_stroke">#994C8DFF</color>
    <color name="glass_primary_ripple">#664C8DFF</color>

    <!-- Barra de navegação flutuante (liquid glass) -->
    <color name="glass_nav_fill">#B8181C22</color>
    <color name="glass_nav_stroke">#26FFFFFF</color>
    <color name="glass_nav_active_indicator">#24FFFFFF</color>

    <!-- ============ Tema CLARO ============ -->
    <color name="light_background">#EEF1F5</color>
    <color name="light_surface">#FFFFFF</color>
    <color name="light_card">#FFFFFF</color>
    <color name="light_card_highlight">#EDF0F4</color>
    <color name="light_outline">#D9DEE6</color>
    <color name="light_on_background">#10131A</color>
    <color name="light_on_surface">#10131A</color>
    <color name="light_on_surface_variant">#5B636F</color>
    <color name="light_on_surface_muted">#8A929E</color>

    <!-- ============ Tema SUPER DARK (AMOLED) ============ -->
    <color name="sd_background">#000000</color>
    <color name="sd_surface">#070809</color>
    <color name="sd_card">#0C0E12</color>
    <color name="sd_card_highlight">#14171C</color>
    <color name="sd_outline">#1E222A</color>
</resources>
