<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         HIERARQUIA TIPOGRÁFICA
         Aplicar via android:textAppearance="@style/..." nos TextViews.
         Evita tamanhos/pesos soltos espalhados pelos layouts.
         ============================================================ -->

    <!-- Maior destaque: saudação, número do chamado na tela de detalhes -->
    <style name="TextAppearance.FieldService.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fsOnBackground</item>
    </style>

    <style name="TextAppearance.FieldService.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fsOnBackground</item>
    </style>

    <!-- Título de seção ("Resumo do dia", "Chamados prioritários") -->
    <style name="TextAppearance.FieldService.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fsOnBackground</item>
    </style>

    <style name="TextAppearance.FieldService.TitleSmall" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fsOnSurface</item>
    </style>

    <!-- Número grande de destaque nos cards de resumo -->
    <style name="TextAppearance.FieldService.Metric" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_metric</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fsOnSurface</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Corpo de texto principal -->
    <style name="TextAppearance.FieldService.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?attr/fsOnSurface</item>
    </style>

    <!-- Texto secundário / de apoio -->
    <style name="TextAppearance.FieldService.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?attr/fsOnSurfaceVariant</item>
    </style>

    <!-- Informação terciária (datas, metadados) -->
    <style name="TextAppearance.FieldService.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">?attr/fsOnSurfaceVariant</item>
    </style>

    <!-- Rótulo discreto de seção ("CLIENTE", "ENDEREÇO") em caixa alta -->
    <style name="TextAppearance.FieldService.SectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/fsOnSurfaceVariant</item>
    </style>

    <!-- Título da barra superior (Toolbar) -->
    <style name="TextAppearance.FieldService.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/fsOnBackground</item>
    </style>

    <!-- ============================================================
         COMPONENTES REUTILIZÁVEIS
         ============================================================ -->

    <!-- Barra superior padrão do app: fundo do app, título com nossa tipografia -->
    <style name="Widget.FieldService.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/fsBackground</item>
        <item name="titleTextAppearance">@style/TextAppearance.FieldService.Toolbar</item>
        <item name="titleTextColor">?attr/fsOnBackground</item>
        <item name="navigationIconTint">?attr/fsOnBackground</item>
    </style>

    <!-- Card padrão: superfície de card + borda sutil (melhor que sombra no dark) -->
    <style name="Widget.FieldService.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/fsCard</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/fsOutline</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Variante para cards não clicáveis (resumo, seções) -->
    <style name="Widget.FieldService.Card.Static">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <!-- Selo (badge) de prioridade/status: pílula com rótulo em caixa alta.
         Fundo e cor do texto/ponto são definidos por código conforme o valor. -->
    <style name="Widget.FieldService.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:drawablePadding">@dimen/space_xxs</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

</resources>
