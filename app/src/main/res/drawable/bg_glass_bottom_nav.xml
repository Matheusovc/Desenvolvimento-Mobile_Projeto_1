<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior "liquid glass": cápsula flutuante de vidro escuro translúcido
     (deixa ver o fundo por trás), com uma fina borda de luz. Cantos totalmente
     arredondados para o formato de pílula, como a tab bar do iOS. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/glass_nav_fill" />
    <stroke
        android:width="@dimen/stroke_hairline"
        android:color="@color/glass_nav_stroke" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
